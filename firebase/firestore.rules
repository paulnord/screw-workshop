rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function active(uid) {
      return !existsAfter(/databases/$(database)/documents/users/$(uid)/control/account);
    }
    match /users/{uid}/control/account {
      allow get: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasAll(['deleting', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['deleting', 'updatedAt'])
        && request.resource.data.deleting == true
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    function validProgress(key) {
      let d = request.resource.data;
      return d.keys().hasAll(['schema', 'kind', 'puzzleId', 'revision', 'bestMoves', 'completed', 'updatedAt'])
        && d.keys().hasOnly(['schema', 'kind', 'puzzleId', 'revision', 'bestMoves', 'completed', 'updatedAt'])
        && d.schema == 1
        && d.kind in ['campaign', 'daily']
        && d.puzzleId is string && d.puzzleId.matches('[a-z0-9-]{1,96}')
        && d.revision is string && d.revision.matches('[a-zA-Z0-9_-]{1,96}')
        && key == d.kind + '__' + d.puzzleId + '__' + d.revision
        && d.bestMoves is int && d.bestMoves >= 1 && d.bestMoves <= 100000
        && d.completed == true
        && d.updatedAt == request.time;
    }
    match /users/{uid}/progress/{key} {
      allow get, list, delete: if owner(uid);
      allow create: if owner(uid) && active(uid) && validProgress(key);
      allow update: if owner(uid) && active(uid) && validProgress(key)
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.puzzleId == resource.data.puzzleId
        && request.resource.data.revision == resource.data.revision
        && request.resource.data.bestMoves <= resource.data.bestMoves;
    }
    // No public profiles, shared leaderboards, or permissive fallback rules.
    match /{document=**} { allow read, write: if false; }
  }
}
